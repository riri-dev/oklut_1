function ThemeOption({ value, label, icon: Icon }: { value: 'light' | 'dark' | 'system'; label: string; icon: typeof Sun }) {
  const { theme, setTheme } = useTheme()
  return (
    <button
      type="button"
      onClick={() => setTheme(value)}
